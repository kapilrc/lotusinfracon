# ==============================================================================
# LOTUS INFRACON - ENVIRONMENT CONFIGURATION FOR VERCEL & LOCAL DEVELOPMENT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMTP EMAIL CONFIGURATION (DomainJerry / HostedEmail)
# ------------------------------------------------------------------------------
SMTP_HOST=mail.hostedemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@lotusinfracon.in
SMTP_PASS=YourEmailPasswordHere
CONTACT_RECEIVER_EMAIL=info@lotusinfracon.in

# ------------------------------------------------------------------------------
# 2. FIREBASE PHONE AUTHENTICATION (Mobile SMS OTP Verification)
# ------------------------------------------------------------------------------
# In Firebase Console (https://console.firebase.google.com):
# Project Settings > General > Your Apps > Add Web App ('</>')
# Copy the values from the firebaseConfig object into the variables below:
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...YourApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lotus-infracon.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lotus-infracon
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lotus-infracon.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_RECAPTCHA_ENABLE=false


