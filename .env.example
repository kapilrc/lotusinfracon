# ==============================================================================
# LOTUS INFRACON - ENVIRONMENT CONFIGURATION FOR VERCEL & LOCAL DEVELOPMENT
# ==============================================================================

# SMTP Host from DomainJerry / HostedEmail:
SMTP_HOST=mail.hostedemail.com

# Standard SSL Port (465) or TLS Port (587)
SMTP_PORT=465
SMTP_SECURE=true

# Your Webmail Username:
SMTP_USER=info@lotusinfracon.in

# Your Webmail Password (Set in DomainJerry Webmail Control Panel):
SMTP_PASS=YourEmailPasswordHere

# Where form inquiry notifications should be delivered:
# (You can also add backup emails separated by comma, e.g. "info@lotusinfracon.in,personal@gmail.com")
CONTACT_RECEIVER_EMAIL=info@lotusinfracon.in
